
# Theme
theme = "Catppuccin Frappe"

# Font
font-feature = -dlig, -calt, -liga
font-thicken = true

# Window
window-save-state = always
unfocused-split-opacity = 0.25
# custom-shader = ~/.config/ghostty/shaders/cursor_blaze_no_trail.glsl
# custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl

# macOS
macos-icon = xray
macos-titlebar-style = tabs
macos-option-as-alt = true

# Mouse & clipboard
mouse-hide-while-typing = true
copy-on-select = true
clipboard-trim-trailing-whitespaces = true

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# Keybinds: config
keybind = cmd+r=reload_config

# Keybinds: tabs
keybind = ctrl+space>1=goto_tab:1
keybind = ctrl+space>2=goto_tab:2
keybind = ctrl+space>3=goto_tab:3
keybind = ctrl+space>4=goto_tab:4
keybind = ctrl+space>5=goto_tab:5
keybind = ctrl+space>6=goto_tab:6
keybind = ctrl+space>7=goto_tab:7
keybind = ctrl+space>8=goto_tab:8
keybind = ctrl+space>9=goto_tab:9
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:1
keybind = cmd+shift+semicolon=prompt_tab_title
